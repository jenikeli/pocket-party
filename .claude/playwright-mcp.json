{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "args": ["--use-angle=gl-egl", "--ignore-gpu-blocklist"]
    },
    "contextOptions": { "viewport": { "width": 1280, "height": 720 } }
  },
  "capabilities": ["vision"],
  "outputDir": "test-results/playwright-mcp",
  "timeouts": { "navigation": 60000 }
}
