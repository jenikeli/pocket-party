# Dependencies (no trailing slash: an implementer's worktree links node_modules, and a link is not a directory)
node_modules

# Git worktrees the implementer subagents build in
.claude/worktrees/

# Secrets: never commit certs, keys, tokens or env files
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*

# Editor and OS noise
.DS_Store
npm-debug.log*

# Test output (browser test screenshots)
test-results/

# Generated TLS cert and key (npm run gen-cert)
certs/
