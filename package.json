{
  "name": "pocket-party",
  "version": "0.1.0",
  "private": true,
  "description": "Local-network party game: phones are controllers, a big screen is the host.",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --dev",
    "check": "node server/check.js",
    "gen-cert": "node server/gen-cert.js",
    "kit-shots": "node tools/kit-shots.js",
    "course-previews": "node tools/course-previews.js",
    "test": "node --test --test-timeout=30000 \"test/unit/*.test.js\" \"test/server/*.test.js\"",
    "test:browser": "node --test --test-timeout=60000 --test-concurrency=1 \"test/browser/*.test.js\""
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
